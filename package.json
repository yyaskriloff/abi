{
  "name": "abi",
  "version": "1.0.0",
  "private": true,
  "description": "Another Bright Idea",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyaskriloff/abi.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yyaskriloff/abi/issues"
  },
  "homepage": "https://github.com/yyaskriloff/abi#readme",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @abi/trpc --filter @abi/admin --filter @abi/org --filter @abi/mobile --filter @abi/volunteer dev",
    "dev:trpc": "pnpm --filter @abi/trpc dev",
    "dev:admin": "pnpm --filter @abi/admin dev",
    "dev:org": "pnpm --filter @abi/org dev",
    "dev:mobile": "pnpm --filter @abi/mobile dev",
    "dev:volunteer": "pnpm --filter @abi/volunteer dev",
    "build": "pnpm -r --filter @abi/trpc --filter @abi/admin --filter @abi/org build",
    "typecheck": "pnpm -r typecheck"
  },
  "dependencies": {
    "railway": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.22.0"
}
